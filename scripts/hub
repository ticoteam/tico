#!/usr/bin/env python3
"""`hub`: the old name of `tico`, the teamwork CLI (clients/hubcli.py). The same CLI, kept as a silent alias through
0.6.x; scripts/tico runs this file for every teamwork word.

Resolves the checkout from its own path, so a symlink to it works from anywhere and a second checkout uses its own
clients/.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from clients import hubcli  # noqa: E402

if __name__ == "__main__":
    sys.exit(hubcli.main(sys.argv[1:]))
