#!/usr/bin/env python3
"""`hub`: the old name of `tico` (clients/hubcli.py). Runs the same command with the same arguments.

Each call says so on its first request (X-Tico-Alias, clients/tico.py), and the server records one `alias.hub_used`
event for it (backend/alias_uses.py). Nothing is printed for it: the output would land in a model's context every call.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
os.environ["TICO_CLI_ALIAS"] = "hub"
from clients import hubcli  # noqa: E402

if __name__ == "__main__":
    sys.exit(hubcli.main(sys.argv[1:]))
