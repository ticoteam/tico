.env
*.env
.DS_Store
runtime/
__pycache__/
app/target/
app/gen/

node_modules/
# The UI's compiled TypeScript (npm run build:ui).
/build/
# The API types, written by scripts/check_ui_types.sh from backend/openapi_v2.py; never committed.
/ui/types/api.d.ts
.venv/
.tmp-*
.pytest_cache/
app/.build/
!docker/versions.env

relay-rs/target/

# Assistant eval runs: transcripts and per-sample results, written by evals/assistant/run.py.
evals/assistant/out/

# Behaviour replay cases hold customer text; only the made-up example lives here.
evals/replay/cases/*
!evals/replay/cases/example.yaml

# Disposable CI plans and test timing receipts.
/ci-plan.json
/ci-results/
/durations.json
/previous-timings/
tools/release-command/target/
.remote-runs/
.ruff_cache/

# Local type-check environment (scripts/check_types.sh).
.venv-pyright/

# Generated from baselines/ by scripts/lint_baseline.py and scripts/pyright_baseline.py: ruff and basedpyright read these
# single files, and git tracks the per-file pieces in baselines/ instead.
/ruff-baseline.toml
/.basedpyright/baseline.json
