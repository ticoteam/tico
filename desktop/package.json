{
  "name": "tico-desktop",
  "productName": "Tico",
  "version": "0.1.0",
  "private": true,
  "description": "Tico on your desk: a thin frame around each company's own web app.",
  "author": "Tico",
  "homepage": "https://github.com/ticoteam/tico",
  "license": "SEE LICENSE IN ../LICENSE",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-local.mjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "pack:mac": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
