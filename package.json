{
  "name": "tico-observability",
  "private": true,
  "engines": {"node": ">=22.18"},
  "scripts": {
    "build:ui": "node scripts/build-ui.cjs",
    "watch:ui": "node scripts/build-ui.cjs --watch",
    "build:observability": "esbuild ui/observability-vendors.ts --bundle --format=esm --minify --outfile=ui/assets/observability-vendors.js",
    "check:observability": "npm run build:ui && node --check build/ui/observability.js && node --check ui/assets/observability-vendors.js",
    "screenshots": "node scripts/screenshots/index.cts",
    "test:ui": "node scripts/ui-tests.cjs"
  },
  "dependencies": {
    "@sentry/browser": "10.76.2",
    "posthog-js": "1.438.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
