{
  "_about": "The Tools chat's key detector rules (spec tools-chat-key-drop). One file for the browser (ui/app/secret-drop.ts, served at GET /api/v2/secret-rules) and the server (backend/secret_drop.py); backend/tests/fixtures/secret_drop_cases.json is run by both. Patterns use only syntax Python re and JavaScript RegExp read alike: no \\b, \\w or \\d (Unicode in one, ASCII in the other), no inline flags (`flags` holds them), no named groups, fixed-width lookbehind only. `group` lists the value's groups, first that took part wins; 0 is the whole match. A value after a strong context word (`words`, from the key's name or from `word_group`) is cancelled only by a placeholder or a `negative_keyed` shape (a web address, an email, a path from /, ~/, ./ or ../): a hex string, a UUID or a relative path after `token:` is still a key (spec Scope 4b: hex is negative only with no context word). After a password word only a placeholder cancels. A word with `spaced` false (pass, pw: also plain English) is not strong in a rule with `spaced` true (a value after a space, not after `:` or `=`).",
  "version": 1,
  "zero_width": "[\u00ad\u200b-\u200d\u2060\ufeff]",
  "services": [
    {"re": "jira|atlassian|confluence", "service": "Jira"},
    {"re": "posthog", "service": "PostHog"},
    {"re": "github", "service": "GitHub"},
    {"re": "gitlab", "service": "GitLab"},
    {"re": "stripe", "service": "Stripe"},
    {"re": "slack", "service": "Slack"},
    {"re": "openai", "service": "OpenAI"},
    {"re": "anthropic|claude", "service": "Anthropic"},
    {"re": "google|gcp", "service": "Google"},
    {"re": "npm", "service": "npm"},
    {"re": "sendgrid", "service": "SendGrid"},
    {"re": "hugging ?face", "service": "Hugging Face"},
    {"re": "notion", "service": "Notion"},
    {"re": "linear", "service": "Linear"},
    {"re": "digital ?ocean", "service": "DigitalOcean"},
    {"re": "aws|amazon", "service": "AWS"},
    {"re": "twilio", "service": "Twilio"},
    {"re": "mailgun", "service": "Mailgun"},
    {"re": "sentry", "service": "Sentry"},
    {"re": "datadog", "service": "Datadog"},
    {"re": "postgres(?:ql)?|mysql|mongo(?:db)?|redis|database", "service": "Database"}
  ],
  "certain": [
    {"id": "stripe_live", "re": "(?<![A-Za-z0-9_])(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{10,}", "group": [0], "kind": "Stripe key", "service": "Stripe", "name": "STRIPE_SECRET_KEY", "type": "api_key"},
    {"id": "stripe_webhook", "re": "(?<![A-Za-z0-9_])whsec_[A-Za-z0-9]{10,}", "group": [0], "kind": "Stripe webhook secret", "service": "Stripe", "name": "STRIPE_WEBHOOK_SECRET", "type": "token"},
    {"id": "anthropic", "re": "(?<![A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{10,}", "group": [0], "kind": "Anthropic key", "service": "Anthropic", "name": "ANTHROPIC_API_KEY", "type": "api_key"},
    {"id": "openai_project", "re": "(?<![A-Za-z0-9_-])sk-proj-[A-Za-z0-9_-]{10,}", "group": [0], "kind": "OpenAI key", "service": "OpenAI", "name": "OPENAI_API_KEY", "type": "api_key"},
    {"id": "openai", "re": "(?<![A-Za-z0-9_-])sk-[A-Za-z0-9_-]{16,}", "group": [0], "kind": "OpenAI key", "service": "OpenAI", "name": "OPENAI_API_KEY", "type": "api_key"},
    {"id": "github", "re": "(?<![A-Za-z0-9_])(?:ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{16,}", "group": [0], "kind": "GitHub token", "service": "GitHub", "name": "GITHUB_TOKEN", "type": "token"},
    {"id": "github_pat", "re": "(?<![A-Za-z0-9_])github_pat_[A-Za-z0-9_]{20,}", "group": [0], "kind": "GitHub token", "service": "GitHub", "name": "GITHUB_TOKEN", "type": "token"},
    {"id": "gitlab", "re": "(?<![A-Za-z0-9_-])glpat-[A-Za-z0-9_-]{16,}", "group": [0], "kind": "GitLab token", "service": "GitLab", "name": "GITLAB_TOKEN", "type": "token"},
    {"id": "slack", "re": "(?<![A-Za-z0-9_-])xox[abprs]-[A-Za-z0-9-]{10,}", "group": [0], "kind": "Slack token", "service": "Slack", "name": "SLACK_TOKEN", "type": "token"},
    {"id": "slack_app", "re": "(?<![A-Za-z0-9_-])xapp-[A-Za-z0-9-]{10,}", "group": [0], "kind": "Slack app token", "service": "Slack", "name": "SLACK_APP_TOKEN", "type": "token"},
    {"id": "atlassian", "re": "(?<![A-Za-z0-9_])ATATT[A-Za-z0-9_=-]{20,}", "group": [0], "kind": "Atlassian token", "service": "Jira", "name": "JIRA_API_TOKEN", "type": "token"},
    {"id": "posthog_personal", "re": "(?<![A-Za-z0-9_])phx_[A-Za-z0-9]{20,}", "group": [0], "kind": "PostHog key", "service": "PostHog", "name": "POSTHOG_API_KEY", "type": "api_key"},
    {"id": "posthog_project", "re": "(?<![A-Za-z0-9_])phc_[A-Za-z0-9]{20,}", "group": [0], "kind": "PostHog project key", "service": "PostHog", "name": "POSTHOG_PROJECT_KEY", "type": "api_key"},
    {"id": "google", "re": "(?<![A-Za-z0-9_-])AIza[A-Za-z0-9_-]{35}(?![A-Za-z0-9_-])", "group": [0], "kind": "Google key", "service": "Google", "name": "GOOGLE_API_KEY", "type": "api_key"},
    {"id": "npm", "re": "(?<![A-Za-z0-9_])npm_[A-Za-z0-9]{30,}", "group": [0], "kind": "npm token", "service": "npm", "name": "NPM_TOKEN", "type": "token"},
    {"id": "sendgrid", "re": "(?<![A-Za-z0-9_.-])SG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}", "group": [0], "kind": "SendGrid key", "service": "SendGrid", "name": "SENDGRID_API_KEY", "type": "api_key"},
    {"id": "huggingface", "re": "(?<![A-Za-z0-9_])hf_[A-Za-z0-9]{20,}", "group": [0], "kind": "Hugging Face token", "service": "Hugging Face", "name": "HF_TOKEN", "type": "token"},
    {"id": "notion", "re": "(?<![A-Za-z0-9_])(?:secret|ntn)_[A-Za-z0-9]{30,}", "group": [0], "kind": "Notion token", "service": "Notion", "name": "NOTION_TOKEN", "type": "token"},
    {"id": "linear", "re": "(?<![A-Za-z0-9_])lin_api_[A-Za-z0-9]{20,}", "group": [0], "kind": "Linear key", "service": "Linear", "name": "LINEAR_API_KEY", "type": "api_key"},
    {"id": "digitalocean", "re": "(?<![A-Za-z0-9_])dop_v1_[a-f0-9]{40,}", "group": [0], "kind": "DigitalOcean token", "service": "DigitalOcean", "name": "DIGITALOCEAN_TOKEN", "type": "token"},
    {"id": "aws", "re": "(?<![A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}(?![A-Za-z0-9])", "group": [0], "kind": "AWS key", "service": "AWS", "name": "AWS_ACCESS_KEY_ID", "type": "api_key"},
    {"id": "pem", "re": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----", "group": [0], "kind": "Private key", "base": "PRIVATE_KEY", "type": "file"},
    {"id": "jwt", "re": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}", "group": [0], "kind": "Token (JWT)", "base": "TOKEN", "type": "token"},
    {"id": "url_login", "re": "[A-Za-z][A-Za-z0-9+.-]*://([^\\s:/@]+):([^\\s/@]+)@", "flags": "i", "group": [2], "user": 1, "kind": "Login", "base": "PASSWORD", "type": "password"},
    {"id": "curl_user", "re": "(?<![A-Za-z0-9_-])(?:-u|--user)[ \\t]+[\"']?([^\\s:\"']+):([^\\s\"']+)", "group": [2], "user": 1, "kind": "Login", "base": "LOGIN", "type": "password"},
    {"id": "login_pair", "re": "(?<![A-Za-z0-9_])(?:user(?:name)?|login|e-?mail)[ \\t]*[:=]?[ \\t]*([^\\s/,:=]+)[ \\t]*(?:/|,|[ \\t](?:and[ \\t]+)?(?:pass(?:word)?|pwd|pw)[ \\t]*[:=]?)[ \\t]*([^\\s\"',;]{4,})", "flags": "i", "group": [2], "user": 1, "kind": "Login", "base": "LOGIN", "type": "password", "check": "not_placeholder"},
    {"id": "bearer", "re": "(?<![A-Za-z0-9_])(bearer|basic|token)[ \\t]+([A-Za-z0-9._~+/=-]{7,}[A-Za-z0-9_~+/=-])", "flags": "i", "group": [2], "word_group": 1, "kind": "Token", "base": "TOKEN", "type": "token", "check": "secretish"},
    {"id": "hex_service", "re": "(twilio|mailgun|sentry|datadog|postmark|mixpanel|amplitude|segment|algolia|pagerduty)[^\\n]{0,40}?(?<![A-Za-z0-9])([a-fA-F0-9]{32})(?![A-Za-z0-9])", "flags": "i", "group": [2], "kind": "API key", "base": "API_KEY", "type": "api_key", "service_group": 1},
    {"id": "env", "re": "^[ \\t]*(?:export[ \\t]+)?([A-Z][A-Z0-9_]*)[ \\t]*=[ \\t]*(?:\"([^\"\\n]+)\"|'([^'\\n]+)'|([^\\s#\"']+))", "flags": "m", "group": [2, 3, 4], "name_group": 1, "kind": "Key", "base": "SECRET", "type": "api_key", "check": "env"},
    {"id": "key_value", "re": "[\"']?((?:(?:api|secret|private|access)[ \\t](?=key))?[A-Za-z0-9_.-]*(?:key|token|secret|password|passwd|passphrase|pwd|pass|pw|auth|credential)[A-Za-z0-9_.-]*)[\"']?[ \\t]*[:=][ \\t]*(?:\"([^\"\\n]{4,})\"|'([^'\\n]{4,})'|([^\\s\"',;}]{4,}))", "flags": "i", "group": [2, 3, 4], "name_group": 1, "kind": "Key", "base": "SECRET", "type": "api_key", "check": "context"},
    {"id": "context_space", "re": "(?<![A-Za-z0-9_])(password|passwd|pwd|pw|pass|token|secret|api[ _-]?key|key|private[ _-]?key)[ \\t]+(?:is[ \\t]+)?([^\\s\"',;]{6,})", "flags": "i", "group": [2], "name_group": 1, "kind": "Key", "base": "SECRET", "type": "api_key", "check": "secretish", "spaced": true}
  ],
  "words": [
    {"re": "^(?:password|passwd|passphrase|pwd)$", "kind": "Password", "base": "PASSWORD", "type": "password", "strong": true},
    {"re": "^(?:pw|pass)$", "kind": "Password", "base": "PASSWORD", "type": "password", "strong": true, "spaced": false},
    {"re": "^(?:private[ _-]?key)$", "kind": "Private key", "base": "PRIVATE_KEY", "type": "file", "strong": true},
    {"re": "^(?:api[ _-]?key|apikey)$", "kind": "API key", "base": "API_KEY", "type": "api_key", "strong": true},
    {"re": "^secret$", "kind": "Secret", "base": "SECRET", "type": "api_key", "strong": true},
    {"re": "^token$", "kind": "Token", "base": "TOKEN", "type": "token", "strong": true},
    {"re": "^bearer$", "kind": "Token", "base": "TOKEN", "type": "token", "strong": true},
    {"re": "^access[ _-]?key$", "kind": "Key", "base": "", "type": "api_key", "strong": true},
    {"re": "^key$", "kind": "Key", "base": "API_KEY", "type": "api_key", "strong": false},
    {"re": "(?:password|passwd|passphrase|pwd)", "kind": "Password", "base": "", "type": "password", "strong": true},
    {"re": "(?:token)", "kind": "Token", "base": "", "type": "token", "strong": true},
    {"re": "(?:secret|api[_-]?key|apikey|private[_-]?key|credential)", "kind": "Key", "base": "", "type": "api_key", "strong": true}
  ],
  "placeholder": "^(?:none|null|nil|true|false|yes|no|empty|redacted|changeme|example|placeholder|required|optional|string|value|undefined|pass(?:word)?|pwd|username|user|login|e-?mail|secret|token|key|x{3,}|\\*{3,}|\\.{3,}|•+|<[^>]*>?|\\$\\{[^}]*\\}|\\$[A-Z_][A-Z0-9_]*|\\{\\{[^}]*\\}\\})$",
  "negative": [
    "[A-Za-z][A-Za-z0-9+.-]*://[^\\s\"'<>]+",
    "[A-Za-z0-9._%+'-]{1,64}@[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?\\.[A-Za-z]{2,24}",
    "(?<![A-Za-z0-9])[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![A-Za-z0-9])",
    "(?<![A-Za-z0-9])[0-9a-fA-F]{7,64}(?![A-Za-z0-9])",
    "(?<![A-Za-z0-9])[0-9]{4}-[0-9]{2}-[0-9]{2}(?:[T ][0-9:.]+Z?)?",
    "(?<![A-Za-z0-9.])v?[0-9]+(?:\\.[0-9]+){1,3}(?:-[A-Za-z0-9.]+)?(?![A-Za-z0-9])",
    "(?<![A-Za-z0-9+/=_.~-])(?:~|\\.{1,2})?(?:/[A-Za-z0-9_.@-]+)+/?",
    "(?<![A-Za-z0-9+/=_.-])(?:[A-Za-z0-9_@-]+/)+[A-Za-z0-9_-]+\\.[A-Za-z0-9]{1,6}(?::[0-9]+)?",
    "(?<![A-Za-z0-9+/=])[a-z0-9_.-]+(?:/[a-z0-9_.-]+)+",
    "(?<![A-Za-z0-9])(?:file|page|run|task|msg|att|sf)-[A-Za-z0-9]{6,}",
    "(?<![A-Za-z0-9])wf_[A-Za-z0-9-]{6,}",
    "(?<![A-Za-z0-9])(?:bot|human|task|page|file|message|person|kind):[A-Za-z0-9._-]+"
  ],
  "negative_keyed": [
    "[A-Za-z][A-Za-z0-9+.-]*://[^\\s\"'<>]+",
    "[A-Za-z0-9._%+'-]{1,64}@[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?\\.[A-Za-z]{2,24}",
    "(?<![A-Za-z0-9+/=_.~-])(?:~|\\.{1,2})?(?:/[A-Za-z0-9_.@-]+)+/?"
  ],
  "token": "[^\\s\"'`,;()<>\\[\\]{}|]+",
  "suspect": {"entropy_length": 20, "entropy_bits": 3.5, "mixed_length": 12, "plain_hex": 12},
  "db_schemes": "^(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|rediss|amqp|amqps|mssql|sqlserver)$"
}
