{
  "$comment": "Generated by web/scripts/gen-screen-actions.ts from the web app’s action registry (npm run gen:screen-actions). Do not edit by hand. What Tico may do on a person’s open app (backend/screen_actions.py); each input is a JSON Schema.",
  "actions": [
    {
      "id": "page.filter",
      "title": "Filter the page",
      "kind": "view",
      "input": {
        "type": "object",
        "properties": {
          "search": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": [
          "search"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "search.open",
      "title": "Search",
      "kind": "view",
      "input": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "shell.closeChat",
      "title": "Close the second chat",
      "kind": "view",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "shell.fold",
      "title": "Fold or open a sheet",
      "kind": "view",
      "input": {
        "type": "object",
        "properties": {
          "sheet": {
            "enum": [
              "tico",
              "menu",
              "list",
              "widgets",
              "side"
            ]
          },
          "folded": {
            "type": "boolean"
          }
        },
        "required": [
          "sheet"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "shell.goTo",
      "title": "Go to a page",
      "kind": "view",
      "input": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^\\/[A-Za-z0-9\\-._~%/]*$",
            "description": "a path inside the app, like /tasks/engineering"
          }
        },
        "required": [
          "to"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "shell.openChat",
      "title": "Open a second chat",
      "kind": "view",
      "input": {
        "type": "object",
        "properties": {
          "chat": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(agent|person|thread):[^\\s]+$",
            "description": "agent:<slug>, person:<id> or thread:<id>"
          }
        },
        "required": [
          "chat"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "task.open",
      "title": "Open a task",
      "kind": "view",
      "input": {
        "type": "object",
        "properties": {
          "task": {
            "type": "integer",
            "minimum": 1
          },
          "pipeline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    }
  ]
}
