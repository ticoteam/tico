# Copy to .env and edit. Keep it private (chmod 600): it holds secrets. Full guide: docs/install.md
# Values with a $ in them need it doubled ($$) in this file.

# --- Quick start on this computer: these three lines are enough, then `docker compose up -d`. ---
# No domain, DNS or sign-in setup. Serves http://127.0.0.1:8765 only; the owner's token is in the tico-data volume
# (docker compose exec server cat /data/local-owner.token). Add a domain and sign-in later, below.
TICO_TEAM_NAME=Acme
# TICO_COMPANY_NAME remains an alias for existing installs; TICO_TEAM_NAME takes precedence.
TICO_OWNER_EMAIL=you@example.com
COMPOSE_PROFILES=updater

# --- For your team: a domain and sign-in. Uncomment all of this; a public address always needs sign-in. ---
# The front door: pick one. Set COMPOSE_PROFILES=caddy,updater or cloudflared,updater above.
# caddy: automatic HTTPS for TICO_DOMAIN. Point its DNS at this server and open ports 80 and 443.
# cloudflared: a Cloudflare tunnel, no open ports. Needs CLOUDFLARE_TUNNEL_TOKEN. It routes TICO_DOMAIN to the server itself.
# TICO_DOMAIN=tico.example.com
# CLOUDFLARE_TUNNEL_TOKEN=

# oidc: any OpenID Connect provider (Google, Okta, Microsoft Entra, ...)
# TICO_AUTH_PROXY=oidc
# TICO_OIDC_ISSUER=https://accounts.google.com
# TICO_OIDC_CLIENT_ID=
# TICO_OIDC_CLIENT_SECRET=
# Optional: only these email domains may sign in, comma-separated (blank: anyone on the roster)
# TICO_OIDC_ALLOWED_DOMAINS=acme.com
# Your own web frontend on another address (docs/custom-frontend.md): exact origins, comma-separated, never *.
# TICO_CORS_ORIGINS=https://app.acme.com,http://localhost:5173
# cloudflare: Cloudflare Access in front of the tunnel
# TICO_AUTH_PROXY=cloudflare
# TICO_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# TICO_ACCESS_AUDIENCE=

# --- Optional: calendar invites, credential access and processing access (docs/permissions.md). ---
# TICO_BLOCK_EXTERNAL_INVITES=1 blocks bots from inviting outside attendees through the calendar Tool.
# TICO_BLOCK_EXTERNAL_INVITES=0
# Health warns about a bot over this many uncached input tokens in a day; 0 turns it off.
# TICO_TOKEN_ALERT_INPUT=100000000
# Comma-separated human emails; blank credential admins uses the owner and Admins.
# TICO_CREDENTIAL_ADMINS=ana@example.com
# AWS KMS key ID or ARN; blank uses the local credential key. Health shows whether wrapping is active.
# TICO_CREDENTIAL_KMS_KEY=
# TICO_PROCESSING_OPERATORS=ana@example.com

# --- Optional: AWS load balancer sign-in (docs/install.md). ---
# TICO_AUTH_PROXY=aws-alb
# TICO_ALB_ARN=
# TICO_ALB_REGION=us-east-1

# --- Optional: a model key for the server's own decision model, which checks incoming mail for spam and injection (bots sign in on the runner, see docs/install.md) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# The TypeSafe (Jev) decisions key, if you have one. It is used ahead of the provider keys.
# TYPESAFE_API_KEY=

# --- Backups. Always on: the database (Litestream) and attachments are copied continuously. Without TICO_BACKUP_URL
# they go to the tico-backups volume on this server, which does not survive losing the server. Set a bucket to fix that.
# TICO_BACKUP=off turns backups off (not recommended). ---
# TICO_BACKUP_URL=s3://my-bucket/tico
# TICO_BACKUP_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TICO_BACKUP_REGION=auto
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# --- Optional: store attachments in a private S3 bucket (docs/files.md). ---
# Put these settings in .env next to compose.yaml, then run `docker compose up -d`.
# Startup checks file keys, backup keys, then the default AWS chain and selects the first that can write.
# Grant the selected source access to this bucket. Pin a source with role, backup or keys if needed.
# TICO_BLOB_BUCKET=acme-files
# TICO_BLOB_REGION=us-east-1
# TICO_BLOB_ENDPOINT=https://s3.example.com
# TICO_BLOB_CREDENTIALS=auto
# TICO_UPLOAD_MAX_BYTES=2147483648
# Optional separate keys for attachments and desktop downloads; set both. Empty values are unset.
# Docker does not forward AWS credentials from the operator's shell; a region is forwarded only when set (below).
# TICO_BLOB_ACCESS_KEY_ID=
# TICO_BLOB_SECRET_ACCESS_KEY=

# --- Optional: where people open objects in a team bucket (docs/files.md, "Links to bucket objects"). ---
# Comma-separated bucket=https://base[/prefix]; s3://bucket/key in a task, comment or chat shows as base/key.
# TICO_S3_VIEW_URLS=acme-files=https://d1234example.cloudfront.net

# TICO_REHEARSAL=1 starts a copy of real data that runs no scheduler, writes no backups and sends nothing out
# (docs/install.md, "Rehearse a migration"). TICO_SCHEDULER=0 alone turns off only the scheduler and directory sync.
# TICO_FLIGHT_RECORDER=0 stops the server keeping its own performance history (docs/observability.md#the-flight-recorder).
# A server with an empty data volume refuses to start when the backup holds a team it cannot restore. Only to knowingly
# begin a new team over an existing backup: TICO_INITIALIZE_EMPTY=1 (remove it again after the first start).

# --- Optional: Slack. Add slack to COMPOSE_PROFILES above, then follow docs/slack.md: create the app from
# connectors/slack-app-manifest.json and paste its two tokens in Tools > Slack (stored encrypted; do not put them here).
# Only to pin the workspace or tune routing; the defaults are right for most installs.
# SLACK_TEAM_ID=T0123456
# SLACK_APP_ID=A0123456
# TICO_SLACK_ROUTE_THRESHOLD=0.6
# TICO_SLACK_ASK_THRESHOLD=0.5
# TICO_SLACK_MAX_RECIPIENTS=3
# TICO_SLACK_DIGEST_MINUTES=60
# TICO_SLACK_DIGEST_CAP=200

# --- Anonymous usage count (PRIVACY.md): a random ID, the version and two yes/no flags ride on the update check.
# Off: TICO_TELEMETRY=off, DO_NOT_TRACK=1, or Settings > Privacy. TICO_TELEMETRY_DEBUG=1 prints what would be sent and sends nothing. ---
# TICO_TELEMETRY=off

# --- Optional: names, a mounted integrations folder (docs/databases.md) and the AWS region for KMS, Secrets Manager
# and S3. Passed to the server and Slack only when set; unset keeps the defaults. ---
# TICO_APP_NAME=Acme
# TICO_ASSISTANT_NAME=Assistant
# TICO_INTEGRATIONS_DIR=/data/integrations
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# Refuse to start the server, Slack or a restore unless STS says they run in this AWS account (12 digits) and, optionally, role.
# TICO_EXPECTED_AWS_ACCOUNT=123456789012
# TICO_EXPECTED_AWS_ROLE=tico-server
# Slack tokens from AWS Secrets Manager instead of Tools > Slack (docs/slack-gateway.md)
# TICO_SLACK_SECRET_ARN=

# --- Optional: keep an install's permanent id when you rebuild a server (docker compose exec server cat /data/environment-id) ---
# TICO_ENVIRONMENT_ID=

# --- Optional: a GitHub organization for the bots' repositories, and the enabled providers ---
# TICO_GITHUB_OWNER=my-org
# When GitHub asks someone to review a task's PR, put them on the task in this role (docs/github-app.md)
# TICO_GITHUB_REVIEW_ROLE=reviewer
# Plain-English task titles: warn (default), refuse, or off
# TICO_TITLE_LINT=warn
# TICO_ENABLED_PROVIDERS=openai
# TICO_DEFAULT_RUNTIME=codex
# TICO_DEFAULT_MODEL=

# --- One-click updates: with the updater profile above and this line, the app's Update button works.
# The updater holds the Docker socket (root on this host); delete both to update with docker compose only. ---
TICO_UPDATER_URL=http://updater:8080

# Local host port; public, runner and MCP URLs follow it. Optional explicit URLs override the defaults.
TICO_PORT=8765
# TICO_PUBLIC_URL=http://127.0.0.1:8765
# TICO_RUNNER_URL=http://127.0.0.1:8765
# TICO_SERVER_NETWORK=tico_default

# --- Versions: latest, or pin a release such as v1.2.3 (the updater keeps this line current) ---
TICO_TAG=v0.2.30
