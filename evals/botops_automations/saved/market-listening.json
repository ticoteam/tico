{
  "created": [
    {
      "name": "Market posts from listening become tasks",
      "owner": "person:dana",
      "enabled": false,
      "trigger": {
        "type": "listening",
        "sources": [
          {
            "id": "news",
            "kind": "search",
            "site": "news",
            "target": "Acme launch OR funding OR lawsuit"
          }
        ],
        "rules": [
          {
            "do": "keep",
            "tag": "market",
            "text": "A launch, funding round, lawsuit or complaint about a named company in our market"
          }
        ],
        "limits": [
          {
            "count": 10,
            "per": "day"
          }
        ],
        "at": "08:00",
        "tz": "UTC"
      },
      "steps": [
        {
          "id": "each",
          "type": "paths",
          "enabled": true,
          "by": "item",
          "paths": [
            {
              "name": "market",
              "when": [
                {
                  "field": "item.tag",
                  "op": "is",
                  "value": "market"
                }
              ],
              "steps": [
                {
                  "id": "task",
                  "type": "action",
                  "enabled": true,
                  "do": "create_task",
                  "args": {
                    "title": "Market post to review: {{item.title}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
