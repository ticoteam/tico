{
  "created": [
    {
      "name": "Weekday summary posted to updates",
      "owner": "person:dana",
      "enabled": false,
      "trigger": {
        "type": "schedule",
        "cron": "0 18 * * 1-5"
      },
      "steps": [
        {
          "id": "summarize",
          "type": "bot_turn",
          "enabled": true,
          "bot": "chief-of-staff",
          "prompt": "Summarize what got done on Acme today in five short bullets."
        },
        {
          "id": "post",
          "type": "action",
          "enabled": true,
          "do": "post_update",
          "args": {
            "text": "{{summary}}"
          }
        }
      ]
    }
  ]
}
