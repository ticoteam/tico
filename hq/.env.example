# Copy to hq/.env (keep it private). See hq/compose.yaml and docs/telemetry.md.
# Any string of 16+ characters: the collector refuses to start without it, so it is only ever run on purpose.
TICO_HQ_KEY=
# Front door: cloudflared (an HQ-only tunnel, no open ports) or caddy (HTTPS on this host's ports 80 and 443).
COMPOSE_PROFILES=cloudflared
HQ_CLIENT_IP_HEADER=CF-Connecting-IP
# Support tickets (docs/support.md): the team's key to list and answer them, 24+ characters. Unset: the staff routes are off.
# HQ_STAFF_KEY=
# Spam and prompt-injection check on new tickets (docs/support.md): the decision-model provider's key. Unset: nothing is sent to anyone and
# every ticket is `unchecked` (filed as usual). HQ_JUDGE_URL only if you point it elsewhere (the default is the provider PRIVACY.md names).
# HQ_JUDGE_KEY=
# HQ_JUDGE_URL=
# Talk to a person on tico.team/setup files a ticket (kind setup-website): at most this many a day in all; 0 turns it off.
# HQ_SETUP_TICKETS_DAILY_CAP=50
# The public hostname, for either front door: the tunnel's route (cloudflared) or the certificate (caddy).
HQ_DOMAIN=updates.tico.team
# HQ_TUNNEL_TOKEN=
# The org builder's suggestions (POST /v1/recruit): without a key HQ ranks locally. Model calls per UTC day are capped.
# OPENAI_API_KEY=
# HQ_RECRUIT_DAILY_CAP=2000
# The setup page on tico.team (/v1/onboarding): keep its per-session counts (no text) only once the owner says yes.
# HQ_ONBOARDING_COUNTS=on
# HQ_ONBOARDING_ORIGINS=https://tico.team
# With caddy, set HQ_CLIENT_IP_HEADER=X-Forwarded-For
# Optional backups: add ",backup" to COMPOSE_PROFILES
# HQ_BACKUP_URL=s3://my-bucket/tico-hq
# HQ_BACKUP_ENDPOINT=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
