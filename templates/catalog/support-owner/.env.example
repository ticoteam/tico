# Names only. Store values in Tools > Credentials and grant them to this bot; never put values in this file or git.
# Only needed once an owner connects a source in bot.yaml `tools:`.
# The mail tool reads GOOGLE_SA_KEY as a file path on the computer, never into the run.
GOOGLE_SA_KEY=
SLACK_BOT_TOKEN=
# Tico HQ support tickets (docs/support.md). Only the project team's own support bot sets these.
HQ_STAFF_KEY=
HQ_URL=
# GitHub issues and Discussions (playbooks/tico-github.md): read access only. Optional for issues, required for Discussions.
GITHUB_TOKEN=
GH_SUPPORT_REPOS=
