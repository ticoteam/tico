{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tico Recorder",
  "version": "0.2.0",
  "identifier": "team.tico.recorder.native",
  "build": {
    "frontendDist": "ui/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tico Recorder",
        "width": 1040,
        "height": 690,
        "minWidth": 640,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBOEI5QUYyMDBCNUUzRkYKUldULzQ3VUE4cHFMYXY1aVY4OHBBMnJZdkdtcXVSUEZ0QjdwTFNqVVY0cUVrUDhsN1h3SUdjdFIK",
      "endpoints": [
        "https://github.com/ticoteam/tico/releases/latest/download/recorder-latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Tico Recorder: meetings recorded on this Mac, sent to Tico",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
