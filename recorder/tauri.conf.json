{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tico Recorder Native",
  "version": "0.2.0",
  "identifier": "team.tico.recorder.native",
  "build": {
    "frontendDist": "ui/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tico Recorder",
        "width": 1040,
        "height": 690,
        "minWidth": 640,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
