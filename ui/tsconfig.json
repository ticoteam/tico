{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["./**/*.js", "./types/**/*.d.ts"],
  "exclude": ["./vendor/**", "./assets/**", "./node_modules/**"]
}
