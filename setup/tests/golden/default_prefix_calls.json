    "UserData": "#!/bin/bash\nset -eu\nexec > >(tee -a /var/log/tico-setup.log) 2>&1\necho tico-setup runner: start $(date -u)\nif ! docker compose version >/dev/null 2>&1; then f=$(mktemp) || exit 1; if ! curl -fsSL https://get.docker.com -o \"$f\"; then rm -f \"$f\"; echo \"tico-setup: could not download https://get.docker.com\" >&2; exit 1; fi; sh \"$f\" || { rc=$?; rm -f \"$f\"; exit \"$rc\"; }; rm -f \"$f\"; fi\nsystemctl enable --now docker\ncommand -v aws >/dev/null || snap install aws-cli --classic\nmkdir -p /opt/tico-runner\numask 077\naws ssm get-parameter --region us-east-1 --name /tico/runner-build/env --with-decryption --query Parameter.Value --output text > /opt/tico-runner/join.env\nif docker ps -a --format '{{.Names}}' | grep -qx tico-runner; then echo 'runner already joined; leaving it'; else\n  set -a; . /opt/tico-runner/join.env; set +a; rm -f /opt/tico-runner/join.env\n  f=$(mktemp) || exit 1; if ! curl -fsSL https://github.com/ticoteam/tico/releases/download/v0.3.71/install.sh -o \"$f\"; then rm -f \"$f\"; echo \"tico-setup: could not download https://github.com/ticoteam/tico/releases/download/v0.3.71/install.sh\" >&2; exit 1; fi; sh \"$f\" --runner --dir /opt/tico-runner --url \"$TICO_JOIN_URL\" --code \"$TICO_JOIN_CODE\" --label \"$TICO_JOIN_LABEL\" || { rc=$?; rm -f \"$f\"; exit \"$rc\"; }; rm -f \"$f\"\nfi\nrm -f /opt/tico-runner/join.env\ntouch /opt/tico-runner/.bootstrapped\necho tico-setup runner: done\n"
